# Build the repository's actual Vision code for Ampere (RTX 3070: SM 86).
# CUDA/TRT libraries are build dependencies; no model or policy is substituted.
FROM robocup-t2-studio:workstation
USER root
RUN curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb -o /tmp/cuda-keyring.deb && dpkg -i /tmp/cuda-keyring.deb
ARG TRT_VERSION=10.13.3.9-1+cuda12.9
RUN printf 'Package: libnvinfer* libnvonnxparsers*\nPin: version %s\nPin-Priority: 1001\n' "$TRT_VERSION" > /etc/apt/preferences.d/tensorrt
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    cuda-nvcc-12-9 cuda-cudart-dev-12-9 \
    libnvinfer-dev=${TRT_VERSION} libnvinfer-plugin-dev=${TRT_VERSION} \
    libnvinfer-bin=${TRT_VERSION} libpcl-dev libceres-dev \
    ros-kilted-image-transport ros-kilted-compressed-image-transport && rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/local/cuda-12.9/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda-12.9/lib64
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
ENV CMAKE_BUILD_PARALLEL_LEVEL=2
ENV MAKEFLAGS=-j2
RUN bash -lc 'source /opt/ros/kilted/setup.bash && source /work/install/setup.bash && colcon build --base-paths /source/src/vision --packages-select vision --build-base /work/build --install-base /work/install --parallel-workers 1 --cmake-args -DCMAKE_CUDA_ARCHITECTURES=86 -DBUILD_CALIBRATION=OFF -DBUILD_TEST=ON'
RUN bash -lc 'source /opt/ros/kilted/setup.bash && source /work/install/setup.bash && ctest --test-dir /work/build/vision --output-on-failure -R "utest_(utils|intrin|data_syncer)$"'
